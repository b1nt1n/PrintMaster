<UserControl x:Class="PrintMaster.Controls.SheetToolsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PrintMaster.Controls" xmlns:local="clr-namespace:PrintMaster.Controls">
 <StackPanel Margin="0,10,0,10" IsEnabled="{Binding CanEdit}">
  <local:DrawingStylePanel/>
  <local:InkToolsPanel/>
  <StackPanel Visibility="{Binding ShowShapeStrokeDefaults,Converter={StaticResource Visible}}">
  <TextBlock Text="Новые объекты" FontWeight="SemiBold" Margin="0,0,0,6"/>
  <local:TextColorEditor Color="{Binding InkColor,Mode=TwoWay}" CanPickColor="{Binding CanPickProjectColor}" ColorLabel="Цвет новых фигур и штрихов"/>
  <DockPanel Margin="0,10,0,0"><TextBlock DockPanel.Dock="Left" Text="Линия, мм" Width="72"/><TextBlock DockPanel.Dock="Right" Text="{Binding SheetStrokeWidthMm,StringFormat={}{0:F1}}" Width="30"/><Slider Minimum="0.1" Maximum="5" Value="{Binding SheetStrokeWidthMm}" TickFrequency="0.1" IsSnapToTickEnabled="True" AutomationProperties.Name="Толщина линии на листе"/></DockPanel>
  <TextBlock Text="Цвет и толщина — для новых фигур и рисунков." Style="{StaticResource Hint}" Margin="0,8,0,0"/>
  </StackPanel>
  <Button Command="{Binding BeginFlowTextCommand}" Margin="0,12,0,0" AutomationProperties.Name="Создать длинный текст с продолжением"><controls:IconLabel Icon="type" Text="{Binding FlowTextLabel}"/></Button>
  <local:TextFormattingPanel/>
  <Border Height="1" Background="{StaticResource Line}" Margin="0,12,0,10"/>
  <TextBlock Text="{Binding SheetObjectSummary}" FontWeight="SemiBold"/>
  <StackPanel Visibility="{Binding ShowObjectGeometry,Converter={StaticResource Visible}}" IsEnabled="{Binding CanResizeObject}">
   <TextBlock Text="Положение X / Y, мм" Style="{StaticResource Hint}" Margin="0,8,0,6"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <local:NumericField Text="{Binding ObjectX,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" AutomationProperties.Name="Положение объекта X" Minimum="-10000" Maximum="10000" Unit="мм" ContextKey="{Binding SelectedSheetObjectId}" RejectionMessage="{Binding Status}"/>
    <local:NumericField Grid.Column="2" Text="{Binding ObjectY,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" AutomationProperties.Name="Положение объекта Y" Minimum="-10000" Maximum="10000" Unit="мм" ContextKey="{Binding SelectedSheetObjectId}" RejectionMessage="{Binding Status}"/>
   </Grid>
   <TextBlock Text="Размер Ш / В, мм" Style="{StaticResource Hint}" Margin="0,10,0,6"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <local:NumericField Text="{Binding ObjectWidth,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" AutomationProperties.Name="Ширина объекта" Minimum="0" MinimumExclusive="True" Maximum="10000" Unit="мм" ContextKey="{Binding SelectedSheetObjectId}" RejectionMessage="{Binding Status}"/>
    <local:NumericField Grid.Column="2" Text="{Binding ObjectHeight,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" AutomationProperties.Name="Высота объекта" Minimum="0" MinimumExclusive="True" Maximum="10000" Unit="мм" ContextKey="{Binding SelectedSheetObjectId}" RejectionMessage="{Binding Status}"/>
   </Grid>
   <StackPanel Visibility="{Binding CanSetPhotoAspectRatio,Converter={StaticResource Visible}}" Margin="0,8,0,8">
    <CheckBox Content="Сохранять пропорции фото" IsChecked="{Binding KeepPhotoAspectRatio,Mode=TwoWay}" AutomationProperties.Name="Сохранять пропорции выбранного фото"/>
    <TextBlock Text="Без галочки ширина и высота меняются независимо. Shift при растягивании временно сохраняет пропорции." Style="{StaticResource Hint}" Margin="0,5,0,0"/>
   </StackPanel>
   <StackPanel Visibility="{Binding CanSetObjectAngle,Converter={StaticResource Visible}}" Margin="0,0,0,10">
    <TextBlock Text="Угол, °" Style="{StaticResource Hint}" Margin="0,0,0,5"/>
    <local:NumericField Text="{Binding ObjectAngle,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" AutomationProperties.Name="Угол выбранного объекта" Minimum="-360000" Maximum="360000" Unit="°" EquivalentAngle="True" ContextKey="{Binding SelectedSheetObjectId}" RejectionMessage="{Binding Status}"/>
   </StackPanel>
   <TextBlock Text="Выровнять по безопасной области" Style="{StaticResource Hint}" Margin="0,12,0,6"/>
   <ComboBox ItemsSource="{Binding PlacementAlignments}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedPlacementAlignment,Mode=TwoWay}" AutomationProperties.Name="Выравнивание по печатной области"/>
   <Button Command="{Binding ApplyPlacementAlignmentCommand}" Margin="0,6,0,0" AutomationProperties.Name="Применить выравнивание объекта"><controls:IconLabel Icon="maximize" Text="Выровнять"/></Button>
   <Button Command="{Binding RemoveSheetObjectCommand}" Margin="0,8,0,0" AutomationProperties.Name="Удалить объект"><controls:IconLabel Icon="trash-2" Text="Удалить объект"/></Button>
  </StackPanel>
  <TextBlock Text="Объекты выходят за пунктирную рамку и будут обрезаны при печати. Проверьте печатный вид." Foreground="#8A471C" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="{Binding HasSheetClipping,Converter={StaticResource Visible}}"/>
 </StackPanel>
</UserControl>
