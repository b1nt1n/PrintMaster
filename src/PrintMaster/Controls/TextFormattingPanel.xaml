<UserControl x:Class="PrintMaster.Controls.TextFormattingPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PrintMaster.Controls" xmlns:local="clr-namespace:PrintMaster.Controls">
  <StackPanel IsEnabled="{Binding CanEdit}" Visibility="{Binding ShowTextFormatting,Converter={StaticResource Visible}}">
   <TextBlock Text="Оформление текста" FontWeight="SemiBold" Margin="0,14,0,7"/>
   <ComboBox ItemsSource="{Binding TextFonts}" IsEditable="True" Text="{Binding TextFontFamily,UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Шрифт текста"/>
   <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <TextBlock Text="Размер, пт" FontSize="11"/>
    <local:NumericField Grid.Column="1" Text="{Binding TextFontSizePt,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" AutomationProperties.Name="Размер выбранного текста" Minimum="0" MinimumExclusive="True" Maximum="1000" Unit="pt" ContextKey="{Binding SelectedText.Id}" RejectionMessage="{Binding TextFormattingError}"/>
   </Grid>
   <WrapPanel Margin="0,8,0,0"><CheckBox IsChecked="{Binding TextBold}" Content="Жирный" FontWeight="Bold" Margin="0,0,18,4" ToolTip="Жирный (Ctrl+B во время ввода)" AutomationProperties.Name="Жирный текст"/><CheckBox IsChecked="{Binding TextItalic}" Content="Курсив" FontStyle="Italic" Margin="0,0,0,4" ToolTip="Курсив (Ctrl+I во время ввода)" AutomationProperties.Name="Курсивный текст"/></WrapPanel>
   <DockPanel Margin="0,8,0,0" Visibility="{Binding CanSetTextWidth,Converter={StaticResource Visible}}"><TextBlock Text="Ширина, мм" DockPanel.Dock="Left" Width="108"/><local:NumericField Text="{Binding TextBlockWidthMm,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" AutomationProperties.Name="Ширина текстового блока" Minimum="0" MinimumExclusive="True" Maximum="10000" Unit="мм" ContextKey="{Binding SelectedText.Id}" RejectionMessage="{Binding TextFormattingError}"/></DockPanel>
   <local:TextColorEditor Color="{Binding TextColor,Mode=TwoWay}" CanPickColor="{Binding CanPickProjectColor}" ColorLabel="Цвет текста" Margin="0,10,0,0"/>
   <ComboBox ItemsSource="{Binding TextAlignments}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding TextAlignment}" Margin="0,8,0,0" AutomationProperties.Name="Выравнивание текста"/>
   <DockPanel Margin="0,8,0,0"><TextBlock Text="Интервал строк" DockPanel.Dock="Left" Width="108"/><local:NumericField Text="{Binding TextLineSpacing,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" AutomationProperties.Name="Межстрочный интервал" Minimum="1" Maximum="3" ContextKey="{Binding SelectedText.Id}" RejectionMessage="{Binding TextFormattingError}"/></DockPanel>
   
   <TextBlock Text="{Binding TextWarning}" TextWrapping="Wrap" Foreground="#8A471C" Margin="0,8,0,0" Visibility="{Binding HasTextWarning,Converter={StaticResource Visible}}"/>
   <TextBlock Text="{Binding TextFormattingError}" TextWrapping="Wrap" Foreground="#AA392C" Margin="0,8,0,0" Visibility="{Binding HasTextFormattingError,Converter={StaticResource Visible}}"/>
   <Button Command="{Binding EditSelectedTextCommand}" Margin="0,8,0,0" Visibility="{Binding IsEditingText,Converter={StaticResource Visible},ConverterParameter=Invert}" AutomationProperties.Name="Редактировать на листе"><controls:IconLabel Icon="pencil" Text="Редактировать на листе"/></Button>

  </StackPanel>
</UserControl>
