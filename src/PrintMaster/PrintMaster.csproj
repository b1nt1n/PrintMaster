<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Brand\app.ico</ApplicationIcon>
    <AssemblyName>PrintMaster</AssemblyName>
    <Version>1.0.36</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="PDFiumCore" Version="155.0.8057" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.26" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <ProjectReference Include="..\ThirdParty\WpfMath\WpfMath.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Icons\*.svg" />
    <Resource Include="Assets\Brand\app.ico" />
    <Resource Include="Assets\Brand\app-logo.png" />
    <Content Include="Assets\Icons\LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Licenses\**\*" Exclude="Assets\Licenses\pdfium\licenses\README.ijg" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\Licenses\pdfium\licenses\README.ijg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
