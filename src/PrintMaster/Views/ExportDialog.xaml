<Window Style="{StaticResource {x:Type Window}}" x:Class="PrintMaster.Views.ExportDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PrintMaster.Controls"
 Title="Экспорт листов" Width="960" Height="740" MinWidth="700" MinHeight="440" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16"><TextBlock Text="Экспорт листов" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" Margin="0,5,0,0"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding PreviewTitle}" TextWrapping="Wrap" Margin="0,0,0,10"/>
    <Border Grid.Row="1" Background="#E8EDF2" Padding="14"><Image Source="{Binding Preview}" Stretch="Uniform" AutomationProperties.Name="Предпросмотр экспорта листа"/></Border>
    <DockPanel Grid.Row="2" Margin="0,10,0,0"><Button DockPanel.Dock="Right" Command="{Binding NextPageCommand}" Style="{StaticResource IconButton}" Margin="6,0,0,0" ToolTip="Следующая страница" AutomationProperties.Name="Следующая страница экспорта"><controls:LucideIcon Icon="chevron-right"/></Button><Button DockPanel.Dock="Right" Command="{Binding PreviousPageCommand}" Style="{StaticResource IconButton}" ToolTip="Предыдущая страница" AutomationProperties.Name="Предыдущая страница экспорта"><controls:LucideIcon Icon="chevron-left"/></Button><TextBlock Text="Подготовка просмотра…" Style="{StaticResource Hint}" Visibility="{Binding IsLoading,Converter={StaticResource Visible}}"/></DockPanel>
   </Grid>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,0">
    <TextBlock Text="Страницы" Style="{StaticResource Label}" Margin="0,0,0,6"/>
    <ComboBox ItemsSource="{Binding Scopes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Scope}" AutomationProperties.Name="Страницы для экспорта"/>
    <TextBlock Text="Формат" Style="{StaticResource Label}"/>
    <ComboBox ItemsSource="{Binding Formats}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Format}" AutomationProperties.Name="Формат экспорта"/>
    <TextBlock Text="{Binding FormatHint}" Style="{StaticResource Hint}" Margin="0,7,0,0"/>
    <TextBlock Text="Качество, DPI" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding DpiChoices}" SelectedItem="{Binding Dpi}" AutomationProperties.Name="DPI экспорта листов"/>
    <TextBlock Text="Вид" Style="{StaticResource Label}"/>
    <ComboBox ItemsSource="{Binding Appearances}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Appearance}" AutomationProperties.Name="Вид экспорта"/>
    <TextBlock Text="{Binding AppearanceHint}" Style="{StaticResource Hint}" Margin="0,7,0,0"/>
    <StackPanel Visibility="{Binding HasAutomaticPages,Converter={StaticResource Visible}}"><TextBlock Text="Размещение исходных страниц" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding ScalingChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Scaling}" AutomationProperties.Name="Размещение при экспорте"/><TextBlock Text="{Binding ScalingHint}" Style="{StaticResource Hint}" Margin="0,5,0,0"/></StackPanel>
    <StackPanel Visibility="{Binding IsMonochrome,Converter={StaticResource Visible}}"><TextBlock Text="Монохром" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding MonoChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Monochrome}" AutomationProperties.Name="Монохром экспорта"/>
     <StackPanel Visibility="{Binding ShowThreshold,Converter={StaticResource Visible}}"><TextBlock Text="Порог черного" Style="{StaticResource Label}"/><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Threshold}" Width="30"/><Slider Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Threshold}" AutomationProperties.Name="Порог экспорта"/></DockPanel></StackPanel>
    </StackPanel>
    <TextBlock Text="Куда сохранить" Style="{StaticResource Label}"/>
    <Button Command="{Binding BrowseOutputCommand}" AutomationProperties.Name="Выбрать путь экспорта"><controls:IconLabel Icon="folder-open" Text="Выбрать файл и папку…"/></Button>
    <TextBox Text="{Binding OutputPath,UpdateSourceTrigger=PropertyChanged}" Margin="0,7,0,0" AutomationProperties.Name="Путь экспорта"/>
    <TextBlock Text="{Binding Outputs}" Style="{StaticResource Hint}" Margin="0,7,0,8"/>
   </StackPanel></ScrollViewer>
  </Grid>
  <StackPanel Grid.Row="2" Margin="0,14,0,0">
   <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding Error}" Foreground="#AA392C" TextWrapping="Wrap" AutomationProperties.Name="Ошибка экспорта"/>
    <TextBlock Text="{Binding Warning}" Foreground="#8A471C" TextWrapping="Wrap"/>
    <CheckBox Content="Экспортировать видимую часть, разрешить указанную обрезку" IsChecked="{Binding AcknowledgeLoss}" Visibility="{Binding HasLoss,Converter={StaticResource Visible}}" Margin="0,7,0,0" AutomationProperties.Name="Подтвердить обрезку при экспорте"/>
   </StackPanel></ScrollViewer>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button IsCancel="True" MinWidth="100" Margin="0,0,10,0" AutomationProperties.Name="Отмена"><controls:IconLabel Icon="x" Text="Отмена"/></Button>
    <Button x:Name="ExportAcceptButton" Click="AcceptExport" IsDefault="True" IsEnabled="{Binding CanAccept}" ToolTip="{Binding SubmitAvailability}" Style="{StaticResource PrimaryButton}" MinWidth="135" AutomationProperties.Name="Подтвердить экспорт листов"><controls:IconLabel Icon="download" Text="Экспортировать"/></Button>
   </StackPanel>
  </StackPanel>
 </Grid>
</Window>
