<Window Style="{StaticResource {x:Type Window}}" x:Class="PrintMaster.Views.PageOptionsDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PrintMaster.Controls"
 Title="Печать выбранных страниц" Width="520" Height="710" MinWidth="420" MinHeight="430" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,0">
   <TextBlock Text="{Binding Summary}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <CheckBox Content="Использовать свои параметры печати" IsChecked="{Binding UseOwnSettings}" Margin="0,16,0,8" AutomationProperties.Name="Свои параметры страницы"/>
   <TextBlock Text="Без этой галочки страница наследует параметры задания." Style="{StaticResource Hint}"/>
   <StackPanel IsEnabled="{Binding UseOwnSettings}">
    <StackPanel IsEnabled="{Binding CanChangePaper}">
     <TextBlock Text="Формат бумаги" Style="{StaticResource Label}"/>
     <ComboBox ItemsSource="{Binding PaperChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Paper}" AutomationProperties.Name="Формат бумаги страницы"/>
     <StackPanel Visibility="{Binding IsNotebookPaper,Converter={StaticResource Visible}}"><TextBlock Text="Профиль тетради" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding NotebookChoices}" DisplayMemberPath="Name" SelectedItem="{Binding Settings.Notebook}" AutomationProperties.Name="Профиль бумаги страницы"/></StackPanel>
     <StackPanel Visibility="{Binding IsCustomPaper,Converter={StaticResource Visible}}"><TextBlock Text="Ширина × длина подачи, мм" Style="{StaticResource Label}"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <controls:NumericField Text="{Binding Settings.CustomWidthMm,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" Minimum="{Binding WidthMinimum}" Maximum="{Binding WidthMaximum}" Unit="мм" AutomationProperties.Name="Ширина бумаги страницы"/>
       <controls:NumericField Grid.Column="2" Text="{Binding Settings.CustomHeightMm,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" Minimum="{Binding HeightMinimum}" Maximum="{Binding HeightMaximum}" Unit="мм" AutomationProperties.Name="Длина бумаги страницы"/>
      </Grid>
     </StackPanel>
     <TextBlock Text="Ориентация" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding OrientationChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Landscape}" AutomationProperties.Name="Ориентация страницы"/>
     <TextBlock Text="Масштабирование" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding ScaleChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Scaling}" AutomationProperties.Name="Масштабирование страницы"/>
    </StackPanel>
    <TextBlock Text="{Binding LayoutHint}" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
    <TextBlock Text="Монохром" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding MonoChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Monochrome}" AutomationProperties.Name="Монохром страницы"/>
    <TextBlock Text="Разрешение печати" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding DpiChoices}" SelectedItem="{Binding Settings.Dpi}" AutomationProperties.Name="Разрешение страницы"/>
    <StackPanel Visibility="{Binding ShowThreshold,Converter={StaticResource Visible}}"><TextBlock Text="Порог чёрного" Style="{StaticResource Label}"/><controls:NumericField Text="{Binding Settings.Threshold,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" Minimum="0" Maximum="255" IsInteger="True" AutomationProperties.Name="Порог чёрного страницы"/></StackPanel>
   </StackPanel>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="1" Margin="0,12,0,0"><TextBlock Text="{Binding Error}" Foreground="#AA392C" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
   <Button IsCancel="True" MinWidth="100" Margin="0,0,12,0" AutomationProperties.Name="Отмена"><controls:IconLabel Icon="x" Text="Отмена"/></Button><Button Click="ApplyClicked" IsDefault="True" IsEnabled="{Binding CanApply}" Style="{StaticResource PrimaryButton}" MinWidth="110" AutomationProperties.Name="Применить параметры страницы"><controls:IconLabel Icon="check" Text="Применить"/></Button>
  </StackPanel></StackPanel>
 </Grid>
</Window>
