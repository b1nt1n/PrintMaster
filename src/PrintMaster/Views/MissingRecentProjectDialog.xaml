<Window Style="{StaticResource {x:Type Window}}" x:Class="PrintMaster.Views.MissingRecentProjectDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PrintMaster.Controls"
 Title="Проект не найден" Width="560" Height="265" MinWidth="440" MinHeight="240" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Border Padding="18" Background="White"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Файл перемещён или удалён" FontSize="18" FontWeight="SemiBold"/>
   <TextBlock Text="Можно указать его новое расположение или убрать запись из недавних проектов." TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12"><TextBlock x:Name="MissingPath" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></ScrollViewer>
  <WrapPanel Grid.Row="2" HorizontalAlignment="Right"><Button x:Name="LocateProjectButton" Click="Locate" Margin="0,0,8,0" IsDefault="True" AutomationProperties.Name="Найти файл…"><controls:IconLabel Icon="folder-open" Text="Найти файл…"/></Button>
   <Button x:Name="RemoveRecentButton" Click="Remove" Margin="0,0,8,0" AutomationProperties.Name="Убрать из списка"><controls:IconLabel Icon="trash-2" Text="Убрать из списка"/></Button>
   <Button IsCancel="True" AutomationProperties.Name="Отмена"><controls:IconLabel Icon="x" Text="Отмена"/></Button></WrapPanel>
 </Grid></Border>
</Window>
