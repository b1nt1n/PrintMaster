<Window Style="{StaticResource {x:Type Window}}" x:Class="PrintMaster.Views.OperationErrorDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PrintMaster.Controls"
 Title="{Binding Title}" Width="600" Height="400" MinWidth="400" MinHeight="260"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Border Padding="18" Background="White">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,6,0">
     <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock x:Name="OperationErrorSummary" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,12,0,0"
      AutomationProperties.Name="Описание ошибки"/>
     <TextBlock Text="Что сделать" FontWeight="SemiBold" Margin="0,16,0,4"/>
     <TextBlock x:Name="OperationErrorNextAction" Text="{Binding NextAction}" TextWrapping="Wrap"
      AutomationProperties.Name="Следующее действие после ошибки"/>
     <Expander x:Name="OperationErrorDetailsExpander" Header="Технические подробности" Margin="0,16,0,0"
      IsExpanded="False" AutomationProperties.Name="Раскрыть технические подробности">
      <TextBox x:Name="OperationErrorDetails" Text="{Binding Details,Mode=OneWay}" IsReadOnly="True"
       IsReadOnlyCaretVisible="True" TextWrapping="Wrap" AcceptsReturn="True" Height="130" Margin="0,8,0,0"
       VerticalContentAlignment="Top"
       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
       AutomationProperties.Name="Технические подробности ошибки, можно выделить и скопировать"/>
     </Expander>
    </StackPanel>
   </ScrollViewer>
   <Button x:Name="OperationErrorCloseButton" Grid.Row="1" IsDefault="True" IsCancel="True"
    HorizontalAlignment="Right" MinWidth="100" Margin="0,16,0,0" AutomationProperties.Name="Закрыть сообщение об ошибке"><controls:IconLabel Icon="x" Text="Закрыть"/></Button>
  </Grid>
 </Border>
</Window>
