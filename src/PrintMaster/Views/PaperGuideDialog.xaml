<Window Style="{StaticResource {x:Type Window}}" x:Class="PrintMaster.Views.PaperGuideDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PrintMaster.Controls"
 Title="{Binding Title}" Width="640" Height="690" MinWidth="480" MinHeight="440" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,10,0">
   <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" Margin="0,9,0,8"/>
   <controls:PrinterPaperDiagram Settings="{Binding Settings}" IsReload="{Binding IsReload}" Height="260" IsHitTestVisible="False" AutomationProperties.Name="{Binding DiagramTitle}"/>
   <TextBlock Text="{Binding Instruction}" TextWrapping="Wrap" Margin="0,10,0,12"/>
   <Expander Header="Совмещение и переворот" Margin="0,4,0,12" Visibility="{Binding CanCalibrate,Converter={StaticResource Visible}}"><StackPanel Margin="0,10,0,0">
    <TextBlock Text="Поправка печати X / Y, мм" Style="{StaticResource Label}"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <controls:NumericField Text="{Binding OffsetXText,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" AutomationProperties.Name="Поправка печати по X" Minimum="-30" Maximum="30" Unit="мм"/><controls:NumericField Grid.Column="2" Text="{Binding OffsetYText,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" AutomationProperties.Name="Поправка печати по Y" Minimum="-30" Maximum="30" Unit="мм"/>
    </Grid>
    <TextBlock Text="Положительное X — вправо, Y — вниз. Проверяется пробным оттиском." Style="{StaticResource Hint}" Margin="0,6,0,0"/>
    <TextBlock Text="Как выходит напечатанная пачка" Style="{StaticResource Label}"/>
    <ComboBox ItemsSource="{Binding StackChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding OutputFaceDown}" AutomationProperties.Name="Порядок выходной пачки"/>
    <TextBlock Text="Ориентация текста на обороте" Style="{StaticResource Label}"/>
    <ComboBox ItemsSource="{Binding RotationChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding BackRotationDegrees}" AutomationProperties.Name="Поворот оборотной стороны"/>
   </StackPanel></Expander>
   <CheckBox Content="Не показывать больше для этого принтера и вида листа" IsChecked="{Binding HideAgain}" Visibility="{Binding CanHide,Converter={StaticResource Visible}}"/>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="1" Margin="0,12,0,0"><TextBlock Text="{Binding Error}" Foreground="#AA392C" TextWrapping="Wrap"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><Button IsCancel="True" MinWidth="100" Margin="0,0,12,0" AutomationProperties.Name="Отмена"><controls:IconLabel Icon="x" Text="Отмена"/></Button><Button Click="ContinueClicked" IsDefault="True" IsEnabled="{Binding CanContinue}" MinWidth="130" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="{Binding ActionLabel}"><controls:IconLabel Icon="{Binding ActionIcon}" Text="{Binding ActionLabel}"/></Button></StackPanel>
  </StackPanel>
 </Grid>
</Window>
