<Window Style="{StaticResource {x:Type Window}}" x:Class="PrintMaster.Views.ApplicationSettingsDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PrintMaster.Controls"
 Title="Настройки PrintMaster" Width="570" Height="640" MinWidth="450" MinHeight="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Grid Background="{StaticResource Background}"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Настройки приложения" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="0,0,14,0">
    <TextBlock Text="Печать по умолчанию" FontWeight="SemiBold" FontSize="15"/>
    <TextBlock Text="Начальные значения новых сеансов. Открытый проект сохраняет свои параметры." Style="{StaticResource Hint}" Margin="0,6,0,0"/>
    <TextBlock Text="Принтер" Style="{StaticResource Label}"/>
    <ComboBox ItemsSource="{Binding PrinterChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding PrinterName}" AutomationProperties.Name="Принтер по умолчанию"/>
    <TextBlock Text="Разрешение, DPI" Style="{StaticResource Label}"/>
    <ComboBox ItemsSource="{Binding DpiChoices}" SelectedItem="{Binding Dpi}" AutomationProperties.Name="DPI по умолчанию"/>
    <TextBlock Text="Монохром" Style="{StaticResource Label}"/>
    <ComboBox ItemsSource="{Binding MonoChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Monochrome}" AutomationProperties.Name="Монохром по умолчанию"/>
    <DockPanel Margin="0,12,0,0"><TextBlock DockPanel.Dock="Left" Text="Порог черного" Width="145"/><TextBlock DockPanel.Dock="Right" Text="{Binding Threshold}" Width="32"/><Slider Minimum="0" Maximum="255" Value="{Binding Threshold}" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Порог по умолчанию"/></DockPanel>
    <Separator Margin="0,16,0,14"/>
    <TextBlock Text="Рабочая сессия" FontSize="15" FontWeight="SemiBold"/>
    <Button Command="{Binding ResetPaperGuidesCommand}" Margin="0,10,0,0" AutomationProperties.Name="Сбросить скрытые подсказки загрузки бумаги"><controls:IconLabel Icon="undo-2" Text="Сбросить скрытые подсказки загрузки бумаги"/></Button>
    <CheckBox Content="Автосохранение для восстановления" IsChecked="{Binding AutosaveEnabled}" Margin="0,10,0,0" AutomationProperties.Name="Автосохранение"/>
    <DockPanel Margin="0,8,0,0" IsEnabled="{Binding AutosaveEnabled}"><TextBlock DockPanel.Dock="Left" Text="Пауза после изменения, сек." Width="230"/><controls:NumericField Text="{Binding AutosaveDelaySeconds,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" Width="70" HorizontalAlignment="Left" AutomationProperties.Name="Пауза автосохранения" Minimum="1" Maximum="60" IsInteger="True" Unit="с"/></DockPanel>
    <Separator Margin="0,16,0,14"/>
    <TextBlock Text="Документы DOCX" FontSize="15" FontWeight="SemiBold"/>
    <TextBlock Text="LibreOffice" Style="{StaticResource Label}"/>
    <DockPanel><Button DockPanel.Dock="Right" Command="{Binding PickLibreOfficeCommand}" Margin="8,0,0,0" AutomationProperties.Name="Выбрать…"><controls:IconLabel Icon="folder-open" Text="Выбрать…"/></Button><TextBox Text="{Binding LibreOfficePath,UpdateSourceTrigger=LostFocus}" ToolTip="Пустое поле — автоматический поиск установленного или встроенного LibreOffice." AutomationProperties.Name="Путь LibreOffice"/></DockPanel>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,14,0,0">
   <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock Text="{Binding Error}" Foreground="#AA392C" TextWrapping="Wrap"/></ScrollViewer>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
    <Button IsCancel="True" Width="100" Margin="0,0,10,0" AutomationProperties.Name="Отмена"><controls:IconLabel Icon="x" Text="Отмена"/></Button>
    <Button Click="Accept" Style="{StaticResource PrimaryButton}" MinWidth="125" AutomationProperties.Name="Сохранить настройки"><controls:IconLabel Icon="save" Text="Сохранить"/></Button>
   </StackPanel>
  </StackPanel>
 </Grid></Grid>
</Window>
