<Window Style="{StaticResource {x:Type Window}}" x:Class="PrintMaster.Views.NotebookProfileDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PrintMaster.Controls"
 Title="Профиль тетради" Width="520" Height="740" MinWidth="420" MinHeight="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Размеры относятся к вашему листу. Разлиновка служит ориентиром и не печатается." Style="{StaticResource Hint}" Margin="0,8,0,14"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,10,0">
   <TextBlock Text="Название профиля" Style="{StaticResource Label}"/><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Название профиля тетради"/>
   <TextBlock Text="Размер листа в редакторе: ширина × высота, мм" Style="{StaticResource Label}"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <controls:NumericField Text="{Binding WidthText,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" AutomationProperties.Name="Ширина тетрадного листа" Minimum="25" Maximum="1000" Unit="мм"/>
    <controls:NumericField Grid.Column="2" Text="{Binding HeightText,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" AutomationProperties.Name="Высота тетрадного листа" Minimum="25" Maximum="1000" Unit="мм"/>
   </Grid>
   <StackPanel Visibility="{Binding IsGrid,Converter={StaticResource Visible}}">
    <TextBlock Text="Клетка: ширина × высота, мм" Style="{StaticResource Label}"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><controls:NumericField Text="{Binding GridWidthText,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" AutomationProperties.Name="Ширина клетки" Minimum="1" Maximum="50" Unit="мм"/><controls:NumericField Grid.Column="2" Text="{Binding GridHeightText,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" AutomationProperties.Name="Высота клетки" Minimum="1" Maximum="50" Unit="мм"/></Grid>
    <TextBlock Text="Сдвиг сетки: X × Y, мм" Style="{StaticResource Label}"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><controls:NumericField Text="{Binding OriginXText,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" AutomationProperties.Name="Сдвиг сетки по X" Minimum="0" Maximum="{Binding ProfileWidth}" Unit="мм"/><controls:NumericField Grid.Column="2" Text="{Binding OriginYText,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" AutomationProperties.Name="Сдвиг сетки по Y" Minimum="0" Maximum="{Binding ProfileHeight}" Unit="мм"/></Grid>
   </StackPanel>
   <StackPanel Visibility="{Binding IsRuled,Converter={StaticResource Visible}}">
    <TextBlock Text="Шаг строк, мм" Style="{StaticResource Label}"/><controls:NumericField Text="{Binding LineStepText,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" AutomationProperties.Name="Шаг строк тетради" Minimum="1" Maximum="100" Unit="мм"/>
    <TextBlock Text="Первая строка от верхнего края, мм" Style="{StaticResource Label}"/><controls:NumericField Text="{Binding FirstLineText,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" AutomationProperties.Name="Первая строка тетради" Minimum="0" Maximum="{Binding ProfileHeight}" Unit="мм"/>
   </StackPanel>
   <CheckBox Content="Красное поле справа" IsChecked="{Binding SingleMarginOnRight}" Visibility="{Binding IsSingle,Converter={StaticResource Visible}}" Margin="0,14,0,0"/>
   <TextBlock Text="Красные поля от левого / правого края, мм" Style="{StaticResource Label}"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><controls:NumericField Text="{Binding LeftMarginText,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" AutomationProperties.Name="Левое красное поле" Minimum="0" Maximum="{Binding ProfileWidth}" Unit="мм"/><controls:NumericField Grid.Column="2" Text="{Binding RightMarginText,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" AutomationProperties.Name="Правое красное поле" Minimum="0" Maximum="{Binding ProfileWidth}" Unit="мм"/></Grid>
   <StackPanel Visibility="{Binding IsSpread,Converter={StaticResource Visible}}">
    <TextBlock Text="Сгиб от левого края, мм" Style="{StaticResource Label}"/><controls:NumericField Text="{Binding FoldText,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" AutomationProperties.Name="Положение сгиба" Minimum="1" Maximum="{Binding FoldMaximum}" Unit="мм"/>
    <TextBlock Text="Отступ текста от сгиба с каждой стороны, мм" Style="{StaticResource Label}"/><controls:NumericField Text="{Binding FoldGapText,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" AutomationProperties.Name="Отступ от сгиба" Minimum="0" Maximum="{Binding FoldGapMaximum}" Unit="мм"/>
   </StackPanel>
   <TextBlock Text="Рабочие отступы сверху / снизу, мм" Style="{StaticResource Label}"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><controls:NumericField Text="{Binding TopText,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" AutomationProperties.Name="Рабочий отступ сверху" Minimum="0" Maximum="{Binding ProfileHeight}" Unit="мм"/><controls:NumericField Grid.Column="2" Text="{Binding BottomText,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" AutomationProperties.Name="Рабочий отступ снизу" Minimum="0" Maximum="{Binding ProfileHeight}" Unit="мм"/></Grid>
   <CheckBox Content="Привязывать основной текст к строкам / клеткам" IsChecked="{Binding AlignTextToRuling}" Margin="0,16,0,0"/>
   <CheckBox Content="Показывать разлиновку в редакторе" IsChecked="{Binding ShowGuides}" Margin="0,8,0,12"/>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="{Binding Error}" Foreground="#AA392C" TextWrapping="Wrap"/>
   <DockPanel Margin="0,10,0,0"><Button DockPanel.Dock="Right" IsEnabled="{Binding CanApply}" IsDefault="True" Click="ApplyClicked" MinWidth="110" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Применить"><controls:IconLabel Icon="check" Text="Применить"/></Button><Button DockPanel.Dock="Right" IsCancel="True" Margin="0,0,10,0" MinWidth="90" AutomationProperties.Name="Отмена"><controls:IconLabel Icon="x" Text="Отмена"/></Button><TextBlock Text="Дробные значения допустимы, например 19,5 мм." Style="{StaticResource Hint}" VerticalAlignment="Center"/></DockPanel>
  </StackPanel>
 </Grid>
</Window>
