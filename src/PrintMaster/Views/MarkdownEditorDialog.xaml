<Window Style="{StaticResource {x:Type Window}}" x:Class="PrintMaster.Views.MarkdownEditorDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:PrintMaster.Controls"
 Title="Markdown и формулы" Width="1120" Height="800" MinWidth="620" MinHeight="500" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
 <Grid Margin="18" Background="White">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,10">
   <WrapPanel>
    <StackPanel Width="210" Margin="0,0,12,7"><TextBlock Text="Название" Style="{StaticResource Hint}" Margin="0,0,0,5"/>
     <TextBox x:Name="DocumentTitle" Text="{Binding Title,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Название документа Markdown"/>
    </StackPanel>
    <StackPanel Width="210" Margin="0,0,12,7"><TextBlock Text="Бумага" Style="{StaticResource Hint}" Margin="0,0,0,5"/>
     <ComboBox x:Name="PaperSelector" ItemsSource="{Binding PaperChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding PaperFormat,Mode=TwoWay}" AutomationProperties.Name="Формат бумаги Markdown"/>
    </StackPanel>
    <StackPanel Width="140" Margin="0,0,12,7"><TextBlock Text="Ориентация" Style="{StaticResource Hint}" Margin="0,0,0,5"/>
     <ComboBox ItemsSource="{Binding OrientationChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Landscape,Mode=TwoWay}" AutomationProperties.Name="Ориентация страниц Markdown"/>
    </StackPanel>
    <StackPanel Width="190" Margin="0,0,0,7" Visibility="{Binding IsNotebookPaper,Converter={StaticResource Visible}}">
     <TextBlock Text="Вид тетрадного листа" Style="{StaticResource Hint}" Margin="0,0,0,5"/>
     <ComboBox ItemsSource="{Binding NotebookChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding NotebookVariant,Mode=TwoWay}" IsEnabled="{Binding CanChangeNotebookVariant}" AutomationProperties.Name="Вид тетрадных страниц Markdown"/>
    </StackPanel>
   </WrapPanel>
   <TextBlock Text="Markdown: заголовки, выделения, таблицы. Формулы: $…$ в строке, $$…$$ отдельным блоком." Style="{StaticResource Hint}"/>
  </StackPanel>
  <Expander x:Name="FormattingExpander" Grid.Row="1" Header="Шрифт, интервалы и поля" Margin="0,0,0,10">
   <ScrollViewer x:Name="FormattingScroll" MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,8,12,8">
     <WrapPanel>
      <StackPanel Width="200" Margin="0,0,12,10"><TextBlock Text="Шрифт" Style="{StaticResource Hint}" Margin="0,0,0,5"/>
       <ComboBox x:Name="FontSelector" ItemsSource="{Binding Fonts}" IsEditable="True" Text="{Binding FontFamily,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Шрифт Markdown"/>
      </StackPanel>
      <StackPanel Width="100" Margin="0,0,12,10"><TextBlock Text="Размер" Style="{StaticResource Hint}" Margin="0,0,0,5"/>
       <controls:NumericField x:Name="FontSizeInput" Text="{Binding FontSizePt,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" Minimum="0" MinimumExclusive="True" Maximum="1000" Unit="pt" AutomationProperties.Name="Размер шрифта Markdown"/>
      </StackPanel>
      <StackPanel Width="125" Margin="0,0,12,10"><TextBlock Text="Интервал строк" Style="{StaticResource Hint}" Margin="0,0,0,5"/>
       <controls:NumericField x:Name="LineSpacingInput" Text="{Binding LineSpacing,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" Minimum="1" Maximum="3" AutomationProperties.Name="Межстрочный интервал Markdown"/>
      </StackPanel>
      <StackPanel Width="125" Margin="0,0,12,10"><TextBlock Text="Между абзацами" Style="{StaticResource Hint}" Margin="0,0,0,5"/>
       <controls:NumericField x:Name="ParagraphGapInput" Text="{Binding ParagraphGapMm,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" Minimum="0" Maximum="100" Unit="мм" AutomationProperties.Name="Интервал абзацев Markdown"/>
      </StackPanel>
      <controls:TextColorEditor Width="190" Color="{Binding Color,Mode=TwoWay}" ColorLabel="Цвет основного текста" Margin="0,0,0,10"/>
     </WrapPanel>
     <TextBlock Text="Поля от краёв листа" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
     <WrapPanel>
      <StackPanel Width="120" Margin="0,0,12,5"><TextBlock Text="Слева" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
       <controls:NumericField x:Name="LeftMarginInput" Text="{Binding MarginLeftMm,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" Minimum="0" Maximum="1000" Unit="мм" AutomationProperties.Name="Левое поле Markdown"/>
      </StackPanel>
      <StackPanel Width="120" Margin="0,0,12,5"><TextBlock Text="Сверху" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
       <controls:NumericField x:Name="TopMarginInput" Text="{Binding MarginTopMm,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" Minimum="0" Maximum="1000" Unit="мм" AutomationProperties.Name="Верхнее поле Markdown"/>
      </StackPanel>
      <StackPanel Width="120" Margin="0,0,12,5"><TextBlock Text="Справа" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
       <controls:NumericField x:Name="RightMarginInput" Text="{Binding MarginRightMm,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" Minimum="0" Maximum="1000" Unit="мм" AutomationProperties.Name="Правое поле Markdown"/>
      </StackPanel>
      <StackPanel Width="120" Margin="0,0,0,5"><TextBlock Text="Снизу" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
       <controls:NumericField x:Name="BottomMarginInput" Text="{Binding MarginBottomMm,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" Minimum="0" Maximum="1000" Unit="мм" AutomationProperties.Name="Нижнее поле Markdown"/>
      </StackPanel>
     </WrapPanel>
     <TextBlock Text="Непечатаемые поля принтера сохраняются. На развороте текст переходит с левой половины на правую." Style="{StaticResource Hint}" Margin="0,5,0,0"/>
     <TextBlock Text="{Binding FontWarning}" Foreground="#8A471C" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="{Binding HasFontWarning,Converter={StaticResource Visible}}"/>
    </StackPanel>
   </ScrollViewer>
  </Expander>
  <Grid x:Name="EditorBody" Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="0"/><RowDefinition Height="0"/></Grid.RowDefinitions>
   <Grid x:Name="SourcePanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <TextBlock Text="Исходник Markdown и LaTeX" FontWeight="SemiBold" Margin="0,0,0,7"/>
    <TextBox x:Name="SourceEditor" Grid.Row="1" Text="{Binding Source,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="13" VerticalContentAlignment="Top"
     AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" SpellCheck.IsEnabled="False"
     Padding="9" AutomationProperties.Name="Исходник Markdown и LaTeX" AutomationProperties.HelpText="Вставьте готовый текст и формулы. Ctrl+A, Ctrl+C, Ctrl+V и Ctrl+Z работают внутри исходника."/>
   </Grid>
   <GridSplitter x:Name="EditorSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" AutomationProperties.Name="Размер панелей Markdown"/>
   <Grid x:Name="PreviewPanel" Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,7">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
      <Button Command="{Binding PreviousPageCommand}" Width="32" Height="28" Padding="6" Margin="0,0,6,0" ToolTip="Предыдущая страница" AutomationProperties.Name="Предыдущая страница Markdown"><controls:LucideIcon Icon="chevron-left"/></Button>
      <Button Command="{Binding NextPageCommand}" Width="32" Height="28" Padding="6" ToolTip="Следующая страница" AutomationProperties.Name="Следующая страница Markdown"><controls:LucideIcon Icon="chevron-right"/></Button>
     </StackPanel>
     <TextBlock Text="{Binding PageLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </DockPanel>
    <Border Grid.Row="1" Background="#E8EDF0" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10">
     <Grid><Image x:Name="MarkdownPreview" Source="{Binding Preview}" Stretch="Uniform" AutomationProperties.Name="Предварительный вид страницы Markdown"/>
      <TextBlock Text="{Binding PreviewStatus}" VerticalAlignment="Top" HorizontalAlignment="Left" Background="#ECFFFFFF" Padding="5,3" FontSize="11"/>
      <Border Background="#FFF8F6" BorderBrush="#AA392C" BorderThickness="1" Padding="12" Margin="8,38,8,8" VerticalAlignment="Center" Visibility="{Binding HasBlockingError,Converter={StaticResource Visible}}">
       <StackPanel><TextBlock Text="Документ не готов" FontWeight="SemiBold" Foreground="#AA392C" TextWrapping="Wrap"/>
        <TextBlock Text="Исправьте ошибку под редактором. Формула не будет пропущена при печати: применить этот черновик пока нельзя." TextWrapping="Wrap" Margin="0,6,0,0"/>
       </StackPanel>
      </Border>
     </Grid>
    </Border>
   </Grid>
  </Grid>
  <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <Border x:Name="MarkdownErrorBanner" BorderBrush="#AA392C" BorderThickness="1" Background="#FFF8F6" Padding="9,7" Visibility="{Binding HasBlockingError,Converter={StaticResource Visible}}">
      <StackPanel><TextBlock Text="Документ не готов к применению" Foreground="#AA392C" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding BlockingError}" Foreground="#AA392C" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Assertive"/>
      </StackPanel>
     </Border>
     <Button Click="GoToErrorClicked" HorizontalAlignment="Left" Padding="7,3" Margin="0,4,0,0" Visibility="{Binding HasErrorLine,Converter={StaticResource Visible}}" AutomationProperties.Name="Перейти к строке с ошибкой"><controls:IconLabel Icon="file-text" Text="Перейти к строке с ошибкой"/></Button>
     <TextBlock Text="{Binding Diagnostics}" Foreground="#8A471C" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding HasDiagnostics,Converter={StaticResource Visible}}"/>
     <TextBlock Text="{Binding SaveStatus}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Row="1" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding ApplyHint}" Style="{StaticResource Hint}" Margin="0,0,14,0" VerticalAlignment="Center"/>
    <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
     <Button x:Name="SaveMarkdownSource" Click="SaveSourceClicked" MinWidth="130" Margin="0,0,8,0" AutomationProperties.Name="Сохранить исходник Markdown независимо от ошибок"><controls:IconLabel Icon="save" Text="Сохранить .md…"/></Button>
     <Button IsCancel="True" MinWidth="80" Margin="0,0,8,0" AutomationProperties.Name="Отмена"><controls:IconLabel Icon="x" Text="Отмена"/></Button>
     <Button x:Name="ApplyMarkdown" Click="ApplyClicked" IsDefault="True" IsEnabled="{Binding CanApply}" MinWidth="110" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Применить страницы Markdown"><controls:IconLabel Icon="check" Text="Применить"/></Button>
    </WrapPanel>
   </Grid>
  </Grid>
 </Grid>
</Window>
