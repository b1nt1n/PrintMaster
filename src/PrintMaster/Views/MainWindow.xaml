<Window Style="{StaticResource {x:Type Window}}" x:Class="PrintMaster.Views.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:sys="clr-namespace:System;assembly=mscorlib"
 xmlns:controls="clr-namespace:PrintMaster.Controls"
 xmlns:models="clr-namespace:PrintMaster.Models"
 Title="{Binding WindowTitle}" Icon="/PrintMaster;component/Assets/Brand/app.ico" Width="1460" Height="940" MinWidth="720" MinHeight="480"
 WindowStartupLocation="CenterScreen" AllowDrop="True" PreviewDrop="FilesDropped" PreviewDragOver="FilesDragOver" DragLeave="FilesDragLeave">
 <Window.CommandBindings>
  <CommandBinding Command="ApplicationCommands.Copy" CanExecute="ClipboardCopyCanExecute" Executed="ClipboardCopyExecuted"/>
  <CommandBinding Command="ApplicationCommands.Cut" CanExecute="ClipboardCopyCanExecute" Executed="ClipboardCutExecuted"/>
  <CommandBinding Command="ApplicationCommands.Undo" CanExecute="UndoRedoCanExecute" Executed="UndoRedoExecuted"/>
  <CommandBinding Command="ApplicationCommands.Redo" CanExecute="UndoRedoCanExecute" Executed="UndoRedoExecuted"/>
  <CommandBinding Command="ApplicationCommands.Paste" CanExecute="ClipboardPasteCanExecute" Executed="ClipboardPasteExecuted"/>
  <CommandBinding Command="ApplicationCommands.SelectAll" CanExecute="SelectAllCanExecute" Executed="SelectAllExecuted"/>
  <CommandBinding Command="ApplicationCommands.Delete" CanExecute="DeleteCanExecute" Executed="DeleteExecuted"/>
 </Window.CommandBindings>
 <Window.InputBindings>
  <KeyBinding Key="O" Modifiers="Control" Command="{Binding AddFilesCommand}"/>
  <KeyBinding Key="N" Modifiers="Control" Command="{Binding CreateSheetCommand}"/>
  <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintCommand}"/>
  <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}"/>
  <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveProjectAsCommand}"/>
  <KeyBinding Key="O" Modifiers="Control+Shift" Command="{Binding OpenProjectCommand}"/>
 </Window.InputBindings>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,6">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="HeaderGrid"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button Grid.Column="2" x:Name="PrintButton" Command="{Binding PrintCommand}" Style="{StaticResource PrimaryButton}" Padding="12,5" AutomationProperties.Name="Открыть окно печати" ToolTip="{Binding PrintAvailability}">
      <StackPanel Orientation="Horizontal"><controls:LucideIcon Icon="printer" Foreground="White" Width="18" Height="18" Margin="0,0,8,0"/><TextBlock Text="{Binding PrintLabel}" Foreground="White" FontWeight="SemiBold"/></StackPanel>
     </Button>
     <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
      <Image Source="/PrintMaster;component/Assets/Brand/app-logo.png" Width="24" Height="24" Margin="0,0,8,0" AutomationProperties.Name="Логотип PrintMaster"/>
      <TextBlock Text="PrintMaster" FontSize="16" FontWeight="SemiBold"/>
     </StackPanel>
     <Menu x:Name="MainMenu" Grid.Column="1" KeyboardNavigation.TabIndex="10" Background="Transparent" VerticalAlignment="Center" Margin="6,0,0,0" IsEnabled="{Binding IsIdle}" ToolTip="{Binding IdleActionAvailability}" ToolTipService.ShowOnDisabled="True" AutomationProperties.HelpText="{Binding IdleActionAvailability}">
      <MenuItem Header="_Проект" AutomationProperties.Name="Проект">
       <MenuItem Header="Создать лист…" Command="{Binding CreateSheetCommand}" InputGestureText="Ctrl+N"><MenuItem.Icon><controls:LucideIcon Icon="file-plus-2" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
       <MenuItem Header="Создать Markdown…" Command="{Binding CreateMarkdownCommand}"><MenuItem.Icon><controls:LucideIcon Icon="file-text" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
       <MenuItem Header="Редактировать Markdown…" Command="{Binding EditMarkdownCommand}"><MenuItem.Icon><controls:LucideIcon Icon="file-text" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
       <MenuItem Header="Открыть проект…" Command="{Binding OpenProjectCommand}" InputGestureText="Ctrl+Shift+O"><MenuItem.Icon><controls:LucideIcon Icon="folder-open" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
       <MenuItem x:Name="RecentProjectsMenu" Header="Недавние проекты" SubmenuOpened="RecentProjectsOpened" AutomationProperties.Name="Недавние проекты"><MenuItem.Icon><controls:LucideIcon Icon="folder-open" Width="16" Height="16"/></MenuItem.Icon>
        <MenuItem Header="Список пока пуст" IsEnabled="False"/>
       </MenuItem>
       <MenuItem Header="Сохранить проект" Command="{Binding SaveProjectCommand}" InputGestureText="Ctrl+S"><MenuItem.Icon><controls:LucideIcon Icon="save" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
       <MenuItem Header="Сохранить копию изображения…" Command="{Binding SaveCopyCommand}"><MenuItem.Icon><controls:LucideIcon Icon="image" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
       <MenuItem Header="Экспорт листов…" Command="{Binding ExportPagesCommand}"><MenuItem.Icon><controls:LucideIcon Icon="download" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
       <MenuItem Header="Фото по сетке…" Command="{Binding ArrangePhotoGridCommand}" ToolTip="{Binding PhotoGridAvailability}"><MenuItem.Icon><controls:LucideIcon Icon="layout-grid" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
       <MenuItem Header="Печать…" Command="{Binding PrintCommand}" InputGestureText="Ctrl+P"><MenuItem.Icon><controls:LucideIcon Icon="printer" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
       <MenuItem Header="Сохранить проект как…" Command="{Binding SaveProjectAsCommand}" InputGestureText="Ctrl+Shift+S"><MenuItem.Icon><controls:LucideIcon Icon="save" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
       <Separator/>
       <MenuItem Header="Включать материалы в проект" IsCheckable="True" IsChecked="{Binding IncludeProjectSources}"/>
       <MenuItem Header="Переподключить исходники…" Command="{Binding RelinkSourcesCommand}"><MenuItem.Icon><controls:LucideIcon Icon="folder-open" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
       <MenuItem Header="Восстановить рабочую сессию…" Command="{Binding RecoverSessionCommand}"><MenuItem.Icon><controls:LucideIcon Icon="undo-2" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
      </MenuItem>
      <MenuItem Header="_Правка" AutomationProperties.Name="Правка">
       <MenuItem Header="Отменить" Command="ApplicationCommands.Undo" InputGestureText="Ctrl+Z" ToolTip="{Binding UndoDescription}"><MenuItem.Icon><controls:LucideIcon Icon="undo-2" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
       <MenuItem Header="Повторить" Command="ApplicationCommands.Redo" InputGestureText="Ctrl+Y" ToolTip="{Binding RedoDescription}"><MenuItem.Icon><controls:LucideIcon Icon="redo-2" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
       <Separator/>
       <MenuItem Header="Выделить все" Command="ApplicationCommands.SelectAll" InputGestureText="Ctrl+A"><MenuItem.Icon><controls:LucideIcon Icon="mouse-pointer-2" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
       <MenuItem Header="Удалить выделенное" Command="ApplicationCommands.Delete" InputGestureText="Del"><MenuItem.Icon><controls:LucideIcon Icon="trash-2" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
       <MenuItem Header="Копировать" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C"><MenuItem.Icon><controls:LucideIcon Icon="copy" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
       <MenuItem Header="Вырезать" Command="ApplicationCommands.Cut" InputGestureText="Ctrl+X"><MenuItem.Icon><controls:LucideIcon Icon="scissors" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
       <MenuItem Header="Вставить" Command="ApplicationCommands.Paste" InputGestureText="Ctrl+V"><MenuItem.Icon><controls:LucideIcon Icon="clipboard-paste" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
       <Separator/>
       <MenuItem Header="Вставить как новую страницу" Command="{Binding PasteClipboardCommand}" CommandParameter="{x:Static models:PasteDestination.Queue}"><MenuItem.Icon><controls:LucideIcon Icon="clipboard-paste" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
       <MenuItem Header="Вставить как Markdown…" Command="{Binding PasteMarkdownCommand}"><MenuItem.Icon><controls:LucideIcon Icon="file-text" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
      </MenuItem>
      <MenuItem Header="_Страницы" AutomationProperties.Name="Страницы">
       <MenuItem Header="Настройки печати выделенных…" Command="{Binding EditPageOptionsCommand}" CommandParameter="selection"><MenuItem.Icon><controls:LucideIcon Icon="settings" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
       <MenuItem Header="Выделить все страницы" Command="{Binding SelectQueuePagesCommand}" InputGestureText="Ctrl+A"><MenuItem.Icon><controls:LucideIcon Icon="mouse-pointer-2" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
       <MenuItem Header="Снять выделение" Command="{Binding ClearQueueSelectionCommand}" InputGestureText="Esc"><MenuItem.Icon><controls:LucideIcon Icon="x" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
       <Separator/>
       <MenuItem Header="Отметить все к печати" Command="{Binding SelectAllCommand}"><MenuItem.Icon><controls:LucideIcon Icon="check" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
       <MenuItem Header="Снять все галочки печати" Command="{Binding SelectNoneCommand}"><MenuItem.Icon><controls:LucideIcon Icon="x" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
       <MenuItem Header="Переключить галочки выделенных" Command="{Binding ToggleHighlightedPrintingCommand}" InputGestureText="Пробел"><MenuItem.Icon><controls:LucideIcon Icon="check" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
       <MenuItem Header="Повернуть выделенные на 90°" Command="{Binding RotateHighlightedPagesCommand}"><MenuItem.Icon><controls:LucideIcon Icon="rotate-cw" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
       <MenuItem Header="Дублировать выделенные" Command="{Binding DuplicateHighlightedPagesCommand}" InputGestureText="Ctrl+D"><MenuItem.Icon><controls:LucideIcon Icon="copy" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
       <MenuItem Header="Переместить выше" Command="{Binding MoveHighlightedPagesCommand}" InputGestureText="Alt+↑"><MenuItem.Icon><controls:LucideIcon Icon="chevron-up" Width="16" Height="16"/></MenuItem.Icon><MenuItem.CommandParameter><sys:Int32>-1</sys:Int32></MenuItem.CommandParameter></MenuItem>
       <MenuItem Header="Переместить ниже" Command="{Binding MoveHighlightedPagesCommand}" InputGestureText="Alt+↓"><MenuItem.Icon><controls:LucideIcon Icon="chevron-down" Width="16" Height="16"/></MenuItem.Icon><MenuItem.CommandParameter><sys:Int32>1</sys:Int32></MenuItem.CommandParameter></MenuItem>
       <MenuItem Header="Удалить выделенные страницы" Command="{Binding DeleteHighlightedPagesCommand}" InputGestureText="Del"><MenuItem.Icon><controls:LucideIcon Icon="trash-2" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
      </MenuItem>
      <MenuItem Header="_Настройки" Command="{Binding ApplicationSettingsCommand}" AutomationProperties.Name="Настройки приложения"/>
      <MenuItem Header="Справка"><MenuItem Header="Горячие клавиши" Click="ShortcutHelp"><MenuItem.Icon><controls:LucideIcon Icon="info" Width="16" Height="16"/></MenuItem.Icon></MenuItem></MenuItem>
     </Menu>
    </Grid>
    <DockPanel Grid.Row="1" Margin="0,6,0,0">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
      <Button x:Name="InspectorToggle" Click="ToggleInspector" Padding="10,5" Margin="6,0,0,0" AutomationProperties.Name="Показать или скрыть свойства"><controls:IconLabel Icon="panel-right" Text="Свойства"/></Button>
     </StackPanel>
     <WrapPanel>
      <Button x:Name="QueueToggle" Click="ToggleQueue" Padding="10,5" Margin="0,0,8,0" AutomationProperties.Name="Показать или скрыть очередь"><controls:IconLabel Icon="panel-left" Text="Страницы"/></Button>
      <Button x:Name="AddFilesButton" Command="{Binding AddFilesCommand}" AutomationProperties.Name="Добавить файлы" Padding="10,5" Margin="0,0,6,0"><controls:IconLabel Icon="folder-open" Text="Добавить файлы"/></Button>
      <Button x:Name="CreateSheetButton" Command="{Binding CreateSheetCommand}" Padding="10,5" Margin="0,0,6,0" AutomationProperties.Name="Создать лист"><controls:IconLabel Icon="file-plus-2" Text="Создать лист"/></Button>
      <Button x:Name="PasteButton" Command="ApplicationCommands.Paste" Focusable="False" Padding="10,5" AutomationProperties.Name="Вставить из буфера" ToolTip="Ctrl+V · назначение зависит от фокуса"><controls:IconLabel Icon="clipboard-paste" Text="Вставить"/></Button>
     </WrapPanel>
    </DockPanel>
   </Grid>
  </Border>
  <Grid x:Name="WorkspaceRoot" Grid.Row="1" SizeChanged="AdaptWorkspace">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="QueueColumn" Width="260"/><ColumnDefinition x:Name="QueueSplitColumn" Width="4"/><ColumnDefinition x:Name="CanvasColumn" Width="*" MinWidth="360"/><ColumnDefinition x:Name="InspectorSplitColumn" Width="4"/><ColumnDefinition x:Name="InspectorColumn" Width="290"/></Grid.ColumnDefinitions>
   <Border x:Name="QueuePane" Grid.Column="0" Background="White">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="16,8">
      <TextBlock Text="Очередь страниц" FontWeight="SemiBold" FontSize="17"/>
      <TextBlock Text="{Binding QueueSummary}" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
      <TextBlock Text="{Binding ProjectSummary}" Style="{StaticResource Hint}" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentProjectPath}"/>
     </StackPanel>
     <ListBox x:Name="QueueList" Grid.Row="1" ItemsSource="{Binding Pages}" SelectionMode="Extended" SelectionChanged="QueueSelectionChanged" BorderThickness="0" Background="White" Padding="10,0"
       ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
       VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
       PreviewMouseLeftButtonDown="QueueMouseDown" PreviewMouseMove="QueueMouseMove" Drop="QueueDropped" PreviewMouseRightButtonDown="QueueRightButtonDown" ContextMenuOpening="QueueContextMenuOpening" AutomationProperties.Name="Очередь страниц">
      <ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu>
      <ListBox.ItemContainerStyle>
       <Style TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="0"/>
        <EventSetter Event="Loaded" Handler="QueueItemLoaded"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
         <Border x:Name="Frame" CornerRadius="6" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#FAFBFC" Padding="10"><ContentPresenter/></Border>
         <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Frame" Property="Background" Value="#EDF4FB"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#8AA9C4"/></Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
       </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
       <DataTemplate>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="73"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,8,0">
          <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2" AutomationProperties.Name="Превью страницы"/>
         </Border>
         <StackPanel Grid.Column="1">
          <CheckBox IsChecked="{Binding IsIncluded}" IsEnabled="{Binding DataContext.IsIdle,RelativeSource={RelativeSource AncestorType=Window}}" Content="{Binding FormatLabel}" FontWeight="SemiBold" Margin="0,0,0,6" AutomationProperties.Name="Включить страницу в печать"/>
          <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OriginalPath}"/>
          <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" Margin="0,5,0,0"/>
         </StackPanel>
         <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0" IsEnabled="{Binding DataContext.IsIdle,RelativeSource={RelativeSource AncestorType=Window}}">
          <Button Style="{StaticResource IconButton}" Width="30" Height="32" MinHeight="32" Command="{Binding DataContext.DecreaseCopiesCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" IsEnabled="{Binding CanDecreaseCopies}" ToolTip="Меньше копий" AutomationProperties.Name="Меньше копий"><controls:LucideIcon Icon="minus" Width="14"/></Button>
          <controls:NumericField Text="{Binding Copies,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" Width="44" Padding="3" TextAlignment="Center" AutomationProperties.Name="Количество копий" Minimum="1" Maximum="999" IsInteger="True" ShowInlineError="False" x:Name="PageCopiesField"/>
          <Button Style="{StaticResource IconButton}" Width="30" Height="32" MinHeight="32" Command="{Binding DataContext.IncreaseCopiesCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" IsEnabled="{Binding CanIncreaseCopies}" ToolTip="Больше копий" AutomationProperties.Name="Больше копий"><controls:LucideIcon Icon="plus" Width="14"/></Button>
          <TextBlock Text="коп." Foreground="{StaticResource Muted}" FontSize="11" Margin="2,0,6,0"/>
         </StackPanel>
         <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Error,ElementName=PageCopiesField}" Foreground="#AA392C" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding Error.Length,ElementName=PageCopiesField,Converter={StaticResource Visible}}"/>
        </Grid>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
     <TextBlock Grid.Row="1" Visibility="{Binding Pages.Count,Converter={StaticResource Visible},ConverterParameter=Invert}" Text="Перетащите сюда файлы&#x0a;или нажмите «Добавить файлы»" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="24" VerticalAlignment="Center"/>
     <StackPanel Grid.Row="2" Margin="12,6" IsEnabled="{Binding IsIdle}">
      <TextBlock Text="{Binding HighlightedSummary}" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
      <WrapPanel Visibility="{Binding HasMultipleHighlightedPages,Converter={StaticResource Visible}}">
       <TextBlock Text="Копии группе" Margin="0,0,6,0"/><controls:NumericField x:Name="BatchCopiesInput" Text="{Binding BatchCopies,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" Width="40" Padding="3" AutomationProperties.Name="Копии выделенным страницам" Minimum="1" Maximum="999" IsInteger="True" ShowInlineError="False"/>
       <Button Command="{Binding SetHighlightedCopiesCommand}" Padding="6,4" Margin="6,2,0,2" AutomationProperties.Name="Применить копии группе"><controls:IconLabel Icon="check" Text="Применить"/></Button>
      </WrapPanel>
      <TextBlock Text="{Binding Error,ElementName=BatchCopiesInput}" Foreground="#AA392C" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding Error.Length,ElementName=BatchCopiesInput,Converter={StaticResource Visible}}"/>
     </StackPanel>
    </Grid>
   </Border>
   <GridSplitter x:Name="QueueSplitter" DragCompleted="WorkspaceSplitterFinished" Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource Line}"/>
   <Grid x:Name="CanvasPane" Grid.Column="2" Background="#E8EDF2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#F8FAFC" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12,4">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="{Binding SelectionTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectionTitle}"/><TextBlock Text="{Binding PaperSummary}" Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding PaperSummary}"/></StackPanel>
      <ToolBar x:Name="CanvasCommands" Grid.Row="1" Background="Transparent" Padding="0" BorderThickness="0" AutomationProperties.Name="Управление холстом">
       <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Command="{Binding UndoCommand}" ToolTip="{Binding UndoDescription}" AutomationProperties.Name="Отменить действие"><controls:LucideIcon Icon="undo-2"/></Button>
       <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Command="{Binding RedoCommand}" ToolTip="{Binding RedoDescription}" AutomationProperties.Name="Повторить действие"><controls:LucideIcon Icon="redo-2"/></Button>
       <Border Width="1" Background="{StaticResource Line}" Margin="8,7"/>
       <Button Style="{StaticResource IconButton}" Command="{Binding RotateCommand}" ToolTip="Повернуть на 90°" AutomationProperties.Name="Повернуть на 90 градусов"><controls:LucideIcon Icon="rotate-cw"/></Button>
       <Border Width="1" Background="{StaticResource Line}" Margin="10,7"/>
       <Button Style="{StaticResource IconButton}" Command="{Binding ZoomOutCommand}" ToolTip="Уменьшить" AutomationProperties.Name="Уменьшить масштаб"><controls:LucideIcon Icon="zoom-out"/></Button>
       <controls:NumericField ToolBar.OverflowMode="Never" x:Name="ZoomInput" Text="{Binding ZoomText,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" Width="55" Padding="3" TextAlignment="Right" AutomationProperties.Name="Масштаб просмотра в процентах" Minimum="5" Maximum="800" AllowPercent="True" ShowInlineError="False"/>
       <TextBlock ToolBar.OverflowMode="Never" Text="%" Margin="3,0,5,0"/>
       <Button Style="{StaticResource IconButton}" Command="{Binding ZoomInCommand}" ToolTip="Увеличить" AutomationProperties.Name="Увеличить масштаб"><controls:LucideIcon Icon="zoom-in"/></Button>
       <Button x:Name="FitPageButton" ToolBar.OverflowMode="Never" Command="{Binding FitZoomCommand}" BorderThickness="0" Padding="6,4" ToolTip="Показать весь лист" AutomationProperties.Name="Показать весь лист"><controls:IconLabel Icon="maximize" Text="Весь лист"/></Button>
      </ToolBar>
     </Grid>
    </Border>
    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="18,9" Visibility="{Binding HasSelection,Converter={StaticResource Visible}}">
     <StackPanel><DockPanel>
      <CheckBox x:Name="PrintPreviewToggle" DockPanel.Dock="Right" IsChecked="{Binding ShowPrintPreview}" Content="Печатный вид" FontWeight="SemiBold" Margin="12,0,0,0" AutomationProperties.Name="Предпросмотр монохромной печати" ToolTip="Показать обработку полутонов и порог до отправки принтеру. Превью 120 DPI."/>
      <TextBlock Text="{Binding CanvasModeLabel}" Style="{StaticResource Hint}" Visibility="{Binding ShowPrintPreview,Converter={StaticResource Visible},ConverterParameter=Invert}"/>
      <TextBlock Text="Предпросмотр результата обработки" Style="{StaticResource Hint}" Visibility="{Binding ShowPrintPreview,Converter={StaticResource Visible}}"/>
     </DockPanel>
     <TextBlock Text="{Binding Error,ElementName=ZoomInput}" Foreground="#AA392C" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="{Binding Error.Length,ElementName=ZoomInput,Converter={StaticResource Visible}}"/>
     </StackPanel>
    </Border>
    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12,6" Visibility="{Binding ShowEditorTools,Converter={StaticResource Visible}}">
     <ToolBar x:Name="DrawingToolbar" Background="White" Padding="0" BorderThickness="0" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Инструменты рисования">
      <ToggleButton Style="{StaticResource ToolButton}" Command="{Binding SetToolCommand}" CommandParameter="{x:Static models:EditorTool.Select}" IsChecked="{Binding Tool,Converter={StaticResource EnumChecked},ConverterParameter=Select,Mode=OneWay}" ToolTip="Выбор и перемещение" AutomationProperties.Name="Выбор"><controls:LucideIcon Icon="mouse-pointer-2"/></ToggleButton>
      <Button Style="{StaticResource IconButton}" Width="36" Height="36" Padding="7" Margin="2" BorderThickness="1" BorderBrush="Transparent" Command="{Binding SetToolCommand}" CommandParameter="{x:Static models:EditorTool.Crop}" IsEnabled="{Binding CanCropSelection}" ToolTip="Кадрировать фото… (C)" AutomationProperties.Name="Кадрирование"><controls:LucideIcon Icon="crop"/></Button>
      <ToggleButton Style="{StaticResource ToolButton}" Command="{Binding SetToolCommand}" CommandParameter="{x:Static models:EditorTool.Arrow}" IsChecked="{Binding Tool,Converter={StaticResource EnumChecked},ConverterParameter=Arrow,Mode=OneWay}" ToolTip="Стрелка" AutomationProperties.Name="Стрелка"><controls:LucideIcon Icon="arrow-up-right"/></ToggleButton>
      <ToggleButton Style="{StaticResource ToolButton}" Command="{Binding SetToolCommand}" CommandParameter="{x:Static models:EditorTool.Rectangle}" IsChecked="{Binding Tool,Converter={StaticResource EnumChecked},ConverterParameter=Rectangle,Mode=OneWay}" ToolTip="Прямоугольник" AutomationProperties.Name="Прямоугольник"><controls:LucideIcon Icon="square"/></ToggleButton>
      <ToggleButton Style="{StaticResource ToolButton}" Command="{Binding SetToolCommand}" CommandParameter="{x:Static models:EditorTool.Ellipse}" IsChecked="{Binding Tool,Converter={StaticResource EnumChecked},ConverterParameter=Ellipse,Mode=OneWay}" ToolTip="Эллипс" AutomationProperties.Name="Эллипс"><controls:LucideIcon Icon="circle"/></ToggleButton>
      <ToggleButton Style="{StaticResource ToolButton}" Command="{Binding SetToolCommand}" CommandParameter="{x:Static models:EditorTool.Text}" IsChecked="{Binding Tool,Converter={StaticResource EnumChecked},ConverterParameter=Text,Mode=OneWay}" ToolTip="Текст" AutomationProperties.Name="Текст"><controls:LucideIcon Icon="type"/></ToggleButton>
      <ToggleButton Style="{StaticResource ToolButton}" Command="{Binding SetToolCommand}" CommandParameter="{x:Static models:EditorTool.Brush}" IsChecked="{Binding Tool,Converter={StaticResource EnumChecked},ConverterParameter=Brush,Mode=OneWay}" ToolTip="Кисть" AutomationProperties.Name="Кисть"><controls:LucideIcon Icon="pencil"/></ToggleButton>
      <ToggleButton Style="{StaticResource ToolButton}" Command="{Binding SetToolCommand}" CommandParameter="{x:Static models:EditorTool.Marker}" IsChecked="{Binding Tool,Converter={StaticResource EnumChecked},ConverterParameter=Marker,Mode=OneWay}" ToolTip="Маркер" AutomationProperties.Name="Маркер"><controls:LucideIcon Icon="highlighter"/></ToggleButton>
      <ToggleButton Style="{StaticResource ToolButton}" Command="{Binding SetToolCommand}" CommandParameter="{x:Static models:EditorTool.Eraser}" IsChecked="{Binding Tool,Converter={StaticResource EnumChecked},ConverterParameter=Eraser,Mode=OneWay}" ToolTip="Частичный ластик кисти и маркера" AutomationProperties.Name="Частичный ластик"><controls:LucideIcon Icon="eraser"/></ToggleButton>
      <ToggleButton Style="{StaticResource ToolButton}" Command="{Binding SetToolCommand}" CommandParameter="{x:Static models:EditorTool.ObjectEraser}" IsChecked="{Binding Tool,Converter={StaticResource EnumChecked},ConverterParameter=ObjectEraser,Mode=OneWay}" ToolTip="Удалить объект целиком" AutomationProperties.Name="Удаление объектов"><controls:LucideIcon Icon="x"/></ToggleButton>
      <ToggleButton x:Name="SnapToggle" Style="{StaticResource ToolButton}" IsChecked="{Binding SnapToPrintableArea,Mode=TwoWay}" Visibility="{Binding IsSheetSelected,Converter={StaticResource Visible}}" ToolTip="Привязка при перемещении к краям и центру печатной области. Во время перетаскивания Alt временно отключает магнит." AutomationProperties.Name="Привязка к печатной области"><controls:LucideIcon Icon="magnet"/></ToggleButton>
      <Border Width="1" Height="24" Background="{StaticResource Line}" Margin="8,6"/>
      <Button Command="{Binding InsertSheetImagesCommand}" Visibility="{Binding CanInsertOnCurrentPage,Converter={StaticResource Visible}}" Margin="8,0,0,0" AutomationProperties.Name="Вставить фото на лист">
       <StackPanel Orientation="Horizontal"><controls:LucideIcon Icon="image" Margin="0,0,6,0"/><TextBlock Text="Вставить фото"/></StackPanel>
      </Button>
      <Button x:Name="PhotoGridButton" Command="{Binding ArrangePhotoGridCommand}" Padding="6" Margin="6,0,0,0" ToolTip="{Binding PhotoGridAvailability}" AutomationProperties.Name="Фото по сетке"><controls:LucideIcon Icon="layout-grid"/></Button>
     </ToolBar>
    </Border>
    <ScrollViewer x:Name="CanvasScroll" Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="30" Focusable="False">
     <Grid x:Name="PaperStage" HorizontalAlignment="Left" VerticalAlignment="Top">
      <Border BorderBrush="#B8C2CC" BorderThickness="1" Visibility="{Binding IsSourceEditorVisible,Converter={StaticResource Visible}}">
       <Border.LayoutTransform><ScaleTransform ScaleX="{Binding ZoomFactor}" ScaleY="{Binding ZoomFactor}"/></Border.LayoutTransform>
       <controls:AnnotationCanvas x:Name="Editor" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" Page="{Binding SelectedPage}" Preview="{Binding EditorPreview}"
         SafeArea="{Binding CanvasSafeArea}" ViewScale="{Binding ZoomFactor}" Scaling="{Binding Settings.Scaling}" IsColorPicking="{Binding IsPickingProjectColor}" IsPrintPreview="{Binding ShowPrintPreview}" Tool="{Binding Tool}" InkColor="{Binding InkColor}" StrokeThickness="{Binding InkStrokeThickness}"
         InkOpacity="{Binding InkOpacity}" EraserDiameter="{Binding EraserDiameter}"
         TextSize="{Binding TextSize}" CropRatio="{Binding CropRatio}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Холст изображения" ContextMenuOpening="CanvasContextMenuOpening">
        <controls:AnnotationCanvas.ContextMenu><ContextMenu/></controls:AnnotationCanvas.ContextMenu>
       </controls:AnnotationCanvas>
      </Border>
      <Border BorderBrush="#B8C2CC" BorderThickness="1" Visibility="{Binding IsSheetSelected,Converter={StaticResource Visible}}">
       <Border.LayoutTransform><ScaleTransform ScaleX="{Binding ZoomFactor}" ScaleY="{Binding ZoomFactor}"/></Border.LayoutTransform>
       <Grid Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}">
       <controls:SheetCanvas PreviewFrame="{Binding EditorFrame}" x:Name="SheetEditor" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" Page="{Binding SelectedPage}" Preview="{Binding EditorPreview}"
         SafeArea="{Binding CanvasSafeArea}" ViewScale="{Binding ZoomFactor}" SnappingEnabled="{Binding SnapToPrintableArea}" IsColorPicking="{Binding IsPickingProjectColor}" IsPrintPreview="{Binding ShowPrintPreview}" Tool="{Binding Tool}" SelectedObjectId="{Binding SelectedSheetObjectId}" SelectedObjectIds="{Binding SelectedObjectIds}"
         InkColor="{Binding InkColor}" StrokeWidthMm="{Binding SheetInkStrokeWidthMm}" InkOpacity="{Binding InkOpacity}" EraserDiameterMm="{Binding SheetEraserDiameterMm}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Холст листа" ContextMenuOpening="CanvasContextMenuOpening">
        <controls:SheetCanvas.ContextMenu><ContextMenu/></controls:SheetCanvas.ContextMenu>
       </controls:SheetCanvas>
       </Grid>
      </Border>
      <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" Visibility="{Binding IsEditingText,Converter={StaticResource Visible}}">
       <Canvas.LayoutTransform><ScaleTransform ScaleX="{Binding ZoomFactor}" ScaleY="{Binding ZoomFactor}"/></Canvas.LayoutTransform>
       <controls:InlineTextEditor x:Name="TextEditor" Canvas.Left="{Binding EditingLeft}" Canvas.Top="{Binding EditingTop}" Width="{Binding EditingWidth}" Height="{Binding EditingHeight}" RenderTransformOrigin="0.5,0.5"><controls:InlineTextEditor.RenderTransform><RotateTransform Angle="{Binding EditingRotation}"/></controls:InlineTextEditor.RenderTransform></controls:InlineTextEditor>
      </Canvas>
      <Canvas x:Name="DropMarkerLayer" IsHitTestVisible="False">
       <Rectangle x:Name="DropRectangle" Visibility="Collapsed" Stroke="#205D94" StrokeThickness="2" StrokeDashArray="4,3" Fill="#15205D94"/>
      </Canvas>
     </Grid>
    </ScrollViewer>
    <StackPanel Grid.Row="3" Visibility="{Binding HasSelection,Converter={StaticResource Visible},ConverterParameter=Invert}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
     <controls:LucideIcon Icon="file-text" Width="52" Height="52" Foreground="#758697" HorizontalAlignment="Center" Margin="0,0,0,20"/>
     <TextBlock Text="Подготовьте свою первую страницу" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center"/>
     <TextBlock Text="Перетащите файлы в окно или нажмите «Создать лист», чтобы начать с чистой страницы." Style="{StaticResource Hint}" Margin="24,10,24,0" TextAlignment="Center" MaxWidth="360"/>
    </StackPanel>
    <TextBlock Grid.Row="3" Text="{Binding PreviewActivity}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20,8" Style="{StaticResource Hint}" IsHitTestVisible="False" TextWrapping="Wrap" MaxWidth="500"/>
    <Border x:Name="DropHintBorder" Grid.Row="3" Visibility="Collapsed" IsHitTestVisible="False" Background="#EDF4FB" BorderBrush="#205D94" BorderThickness="1" CornerRadius="5" Padding="12,8" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Bottom" MaxWidth="450">
     <TextBlock x:Name="DropHintText" TextWrapping="Wrap"/>
    </Border>

    <Border Grid.Row="4" Padding="12,6" Background="White" Visibility="{Binding IsEditingText,Converter={StaticResource Visible}}">
     <WrapPanel><StackPanel Orientation="Horizontal" Margin="0,0,12,0">
      <Button Command="{Binding FinishTextEditCommand}" Padding="12,5" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Завершить ввод текста"><TextBlock Text="Готово" Foreground="White"/></Button>
      <Button Command="{Binding CancelTextEditCommand}" Padding="12,5" Margin="8,0,0,0" AutomationProperties.Name="Отменить ввод текста"><controls:IconLabel Icon="x" Text="Отмена"/></Button>
     </StackPanel><TextBlock Text="Ctrl+Enter — готово · Esc — отмена" Style="{StaticResource Hint}"/></WrapPanel>
    </Border>
   </Grid>
   <GridSplitter x:Name="InspectorSplitter" DragCompleted="WorkspaceSplitterFinished" Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource Line}"/>
   <Border x:Name="InspectorPane" Grid.Column="4" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="{Binding InspectorTitle}" FontWeight="SemiBold" FontSize="16" Margin="16,14"/>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="16,0,16,16">
       <Expander Header="Формат листа" IsExpanded="False" Visibility="{Binding ShowFreeSheetPaper,Converter={StaticResource Visible}}" Margin="0,0,0,12">
        <StackPanel IsEnabled="{Binding CanEdit}">
         <ComboBox ItemsSource="{Binding PaperChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding LayoutSettings.Paper}" Margin="0,8,0,0" AutomationProperties.Name="Формат редактируемого листа"/>
         <StackPanel Visibility="{Binding IsNotebookLayout,Converter={StaticResource Visible}}" Margin="0,8,0,0">
          <TextBlock Text="Вид тетрадного листа" Style="{StaticResource Label}"/>
          <ComboBox ItemsSource="{Binding NotebookChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding NotebookVariant}" AutomationProperties.Name="Вид редактируемого тетрадного листа"/>
          <Expander Header="Профиль и разлиновка" Margin="0,8,0,0"><StackPanel Margin="0,6,0,0">
           <ComboBox ItemsSource="{Binding NotebookProfileChoices}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedNotebookProfile}" AutomationProperties.Name="Профиль редактируемой тетради"/>
           <TextBlock Text="{Binding NotebookProfileSummary}" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
           <WrapPanel Margin="0,6,0,0"><Button Command="{Binding EditNotebookProfileCommand}" Margin="0,0,6,0" AutomationProperties.Name="Настроить…"><controls:IconLabel Icon="settings" Text="Настроить…"/></Button><Button Command="{Binding CopyNotebookProfileCommand}" AutomationProperties.Name="Копия профиля"><controls:IconLabel Icon="copy" Text="Копия профиля"/></Button></WrapPanel>
           <TextBlock Text="Разлиновка — только для ориентира." Style="{StaticResource Hint}" Margin="0,6,0,0"/>
          </StackPanel></Expander>
         </StackPanel>
         <StackPanel Visibility="{Binding IsCustomLayout,Converter={StaticResource Visible}}" Margin="0,8,0,0">
          <TextBlock Text="Ширина × высота, мм" Style="{StaticResource Hint}"/>
          <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
           <controls:NumericField Text="{Binding LayoutSettings.CustomWidthMm,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" AutomationProperties.Name="Ширина макета" Minimum="25" Maximum="1000" Unit="мм" ContextKey="{Binding SelectedPage.Id}"/>
           <controls:NumericField Grid.Column="2" Text="{Binding LayoutSettings.CustomHeightMm,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" AutomationProperties.Name="Высота макета" Minimum="25" Maximum="1000" Unit="мм" ContextKey="{Binding SelectedPage.Id}"/>
          </Grid>
         </StackPanel>
         <ComboBox ItemsSource="{Binding OrientationChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding LayoutSettings.Landscape}" Margin="0,8,0,0" AutomationProperties.Name="Ориентация редактируемого листа"/>
         <TextBlock Text="{Binding LayoutPaperLimits}" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
         <TextBlock Text="Изменение макета отменяется через Ctrl+Z." Style="{StaticResource Hint}" Margin="0,6,0,0"/>
        </StackPanel>
       </Expander>
       <Button Command="{Binding ShowPaperGuideCommand}" Margin="0,0,0,12" Visibility="{Binding HasSelection,Converter={StaticResource Visible}}" AutomationProperties.Name="Схема загрузки бумаги выбранной страницы"><controls:IconLabel Icon="printer" Text="Как загрузить бумагу…"/></Button>
       <controls:SheetToolsPanel Visibility="{Binding IsSheetSelected,Converter={StaticResource Visible}}"/>
       <Button Command="{Binding EditMarkdownCommand}" Visibility="{Binding HasMarkdown,Converter={StaticResource Visible}}" Margin="0,0,0,12" AutomationProperties.Name="Редактировать исходник Markdown"><controls:IconLabel Icon="file-text" Text="Редактировать Markdown…"/></Button>
       <controls:TextFormattingPanel Visibility="{Binding CanCropImage,Converter={StaticResource Visible}}"/>
       <TextBlock Text="{Binding NotebookOverflowMessage}" Foreground="#8A471C" TextWrapping="Wrap" Margin="0,6,0,10"/>
       <StackPanel Visibility="{Binding HasPendingPaperJob,Converter={StaticResource Visible}}" Margin="0,8,0,12">
        <TextBlock Text="{Binding PendingPaperMessage}" Style="{StaticResource Hint}"/>
        <Button Command="{Binding DiscardPaperJobCommand}" Margin="0,6,0,0" AutomationProperties.Name="Закрыть ожидающее задание"><controls:IconLabel Icon="x" Text="Закрыть ожидающее задание"/></Button>
       </StackPanel>
       <StackPanel Visibility="{Binding CanCropImage,Converter={StaticResource Visible}}">
        <Button Command="{Binding PlaceSourceImageCommand}" Margin="0,0,0,12" ToolTip="Размер и поворот ручками, свободное положение на листе; исходник и правки сохраняются" AutomationProperties.Name="Разместить фото на листе"><controls:IconLabel Icon="image" Text="Разместить фото на листе"/></Button>
        <controls:DrawingStylePanel/>
        <controls:InkToolsPanel/>
        <StackPanel Visibility="{Binding ShowShapeStrokeDefaults,Converter={StaticResource Visible}}" IsEnabled="{Binding CanEdit}">
         <TextBlock Text="Для новых аннотаций" FontWeight="SemiBold"/>
         <controls:TextColorEditor Color="{Binding InkColor,Mode=TwoWay}" CanPickColor="{Binding CanPickProjectColor}" ColorLabel="Цвет новых аннотаций" Margin="0,8,0,0"/>
         <TextBlock Text="Толщина, ед." Style="{StaticResource Hint}" Margin="0,10,0,5"/>
         <controls:NumericField Text="{Binding BrushThickness,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}"
          Minimum="0" MinimumExclusive="True" Maximum="1000" Unit="ед." ContextKey="{Binding InkToolContextKey}" AutomationProperties.Name="Толщина новой аннотации"/>
        </StackPanel>
        <Button Command="{Binding ResetCropCommand}" Margin="0,12,0,0" AutomationProperties.Name="Сбросить кадрирование"><controls:IconLabel Icon="undo-2" Text="Сбросить кадрирование"/></Button>
       </StackPanel>
       <TextBlock Text="Документ доступен для просмотра и поворота. Страницы для печати отмечаются в очереди." Style="{StaticResource Hint}" Visibility="{Binding IsDocumentSelected,Converter={StaticResource Visible}}"/>
       <Expander Header="Копия изображения" Margin="0,14,0,0" Visibility="{Binding IsImageSelected,Converter={StaticResource Visible}}">
        <StackPanel Margin="0,8,0,0">
         <DockPanel><TextBlock Text="Разрешение, DPI" DockPanel.Dock="Left"/><ComboBox ItemsSource="{Binding DpiChoices}" SelectedItem="{Binding ExportDpi}" Width="85" HorizontalAlignment="Right" AutomationProperties.Name="DPI сохранения копии"/></DockPanel>
         <Button Command="{Binding SaveCopyCommand}" Margin="0,8,0,0" AutomationProperties.Name="Сохранить копию изображения"><controls:IconLabel Icon="save" Text="Сохранить копию…"/></Button>
        </StackPanel>
       </Expander>
       <TextBlock Text="Выберите страницу или создайте новый лист." Style="{StaticResource Hint}" Visibility="{Binding HasSelection,Converter={StaticResource Visible},ConverterParameter=Invert}"/>
       <Expander Header="Подсказка" Margin="0,16,0,0"><TextBlock Text="{Binding CanvasHint}" Style="{StaticResource Hint}" Margin="0,6,0,0"/></Expander>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Border>
  </Grid>
  <StackPanel Grid.Row="2">
   <Border x:Name="MarkdownWarningBanner" Background="#FFF8F6" BorderBrush="#AA392C" BorderThickness="0,1,0,0" Padding="20,8" Visibility="{Binding HasMarkdownWarning,Converter={StaticResource Visible}}">
    <DockPanel><Button DockPanel.Dock="Right" Command="{Binding DismissMarkdownWarningCommand}" Padding="5" Margin="10,0,0,0" VerticalAlignment="Top" AutomationProperties.Name="Скрыть предупреждение Markdown" ToolTip="Скрыть предупреждение"><controls:LucideIcon Icon="x" Width="16" Height="16"/></Button>
     <ScrollViewer MaxHeight="88" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <TextBlock Text="{Binding MarkdownWarning}" TextWrapping="Wrap" Foreground="#AA392C" AutomationProperties.LiveSetting="Assertive"/>
     </ScrollViewer>
    </DockPanel>
   </Border>
  <Border Height="32" Background="#F8FAFC" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,0">
   <DockPanel><Button DockPanel.Dock="Right" Command="{Binding CancelCommand}" ToolTip="Отмена выполняется после безопасного завершения текущего этапа" Padding="8,2" MinHeight="24" Margin="8,0,0,0" Visibility="{Binding IsBusy,Converter={StaticResource Visible}}" AutomationProperties.Name="Отменить"><controls:IconLabel Icon="x" Text="Отменить"/></Button><ProgressBar x:Name="OperationProgressBar" DockPanel.Dock="Right" Minimum="0" Maximum="{Binding ProgressTotal}" Value="{Binding ProgressCompleted}" IsIndeterminate="{Binding IsProgressIndeterminate}" ToolTip="{Binding ProgressDescription}" Width="100" Height="4" Margin="12,0" Visibility="{Binding IsBusy,Converter={StaticResource Visible}}"/>
    <TextBlock DockPanel.Dock="Left" Text="{Binding OperationLabel}" FontWeight="SemiBold" Margin="0,0,8,0" MaxWidth="120" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Visibility="{Binding IsBusy,Converter={StaticResource Visible}}"/>
    <TextBlock DockPanel.Dock="Right" Text="{Binding ProjectMessage}" Style="{StaticResource Hint}" Margin="12,0,0,0" MaxWidth="140" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProjectMessage}"/>
    <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
   </DockPanel>
  </Border>
  </StackPanel>
 </Grid>
</Window>


