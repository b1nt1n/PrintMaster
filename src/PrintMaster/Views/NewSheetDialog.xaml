<Window Style="{StaticResource {x:Type Window}}" x:Class="PrintMaster.Views.NewSheetDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PrintMaster.Controls"
 Title="Создать лист" Width="470" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
 <Border Padding="24" Background="{StaticResource Background}"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
  <TextBlock Text="Новый лист" FontSize="21" FontWeight="SemiBold"/>
  <TextBlock Text="Формат бумаги" Style="{StaticResource Label}"/>
  <ComboBox ItemsSource="{Binding PaperChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Paper}" AutomationProperties.Name="Формат нового листа"/>
  <StackPanel Visibility="{Binding IsNotebook,Converter={StaticResource Visible}}" Margin="0,10,0,0">
   <TextBlock Text="Вид тетрадного листа" Style="{StaticResource Label}"/>
   <ComboBox ItemsSource="{Binding NotebookChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding NotebookVariant}" AutomationProperties.Name="Вид нового тетрадного листа"/>
   <Expander Header="Профиль и отступы" Margin="0,8,0,0"><StackPanel Margin="0,8,0,0">
    <ComboBox ItemsSource="{Binding NotebookProfileChoices}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedNotebookProfile}" AutomationProperties.Name="Профиль нового тетрадного листа"/>
    <Button Click="NotebookProfileClicked" Margin="0,8,0,0" AutomationProperties.Name="Настроить профиль…"><controls:IconLabel Icon="settings" Text="Настроить профиль…"/></Button>
    <TextBlock Text="Разлиновка — только для ориентира." Style="{StaticResource Hint}" Margin="0,6,0,0"/>
   </StackPanel></Expander>
  </StackPanel>
  <StackPanel Visibility="{Binding IsCustom,Converter={StaticResource Visible}}" Margin="0,12,0,0">
   <TextBlock Text="Ширина подачи × длина, мм" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <controls:NumericField Text="{Binding WidthText,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" AutomationProperties.Name="Ширина нового листа" Minimum="{Binding WidthMinimum}" Maximum="{Binding WidthMaximum}" Unit="мм"/>
    <TextBlock Grid.Column="1" Text="×" HorizontalAlignment="Center"/>
    <controls:NumericField Grid.Column="2" Text="{Binding HeightText,Mode=TwoWay,Converter={StaticResource NumericValue},UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" AutomationProperties.Name="Длина нового листа" Minimum="{Binding HeightMinimum}" Maximum="{Binding HeightMaximum}" Unit="мм"/>
   </Grid>
  </StackPanel>
  <TextBlock Text="Ориентация" Style="{StaticResource Label}"/>
  <ComboBox ItemsSource="{Binding Orientations}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Landscape}" AutomationProperties.Name="Ориентация нового листа"/>
  <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" Margin="0,14,0,0"/>
  <TextBlock Text="{Binding Limits}" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
  <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="#AA392C" Margin="0,8,0,0"/>
  </StackPanel></ScrollViewer><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
   <Button IsCancel="True" MinWidth="90" Margin="0,0,10,0" AutomationProperties.Name="Отмена"><controls:IconLabel Icon="x" Text="Отмена"/></Button>
   <Button IsDefault="True" IsEnabled="{Binding CanCreate}" Click="CreateClicked" Style="{StaticResource PrimaryButton}" MinWidth="110" AutomationProperties.Name="Создать лист"><controls:IconLabel Icon="file-plus-2" Text="Создать"/></Button>
  </StackPanel>
 </Grid></Border>
</Window>
